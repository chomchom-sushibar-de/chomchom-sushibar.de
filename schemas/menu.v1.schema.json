{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chomchom-sushibar-de.github.io/schemas/menu.v1.schema.json",
  "title": "Chôm Chôm canonical menu v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentVersion", "currency", "source", "priceModes", "suggestions", "categories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
    "currency": { "const": "EUR" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentedOrigin", "asOf", "files", "migrationBaseline"],
      "properties": {
        "documentedOrigin": { "type": "string", "minLength": 1, "maxLength": 240 },
        "asOf": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "migrationBaseline": { "type": "string", "const": "tests/fixtures/menu-pre-migration.v1.json" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^menu/[^/]+\\.pdf$" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "priceModes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "supported"],
      "properties": {
        "default": { "enum": ["day", "evening"] },
        "supported": {
          "type": "array",
          "const": ["day", "evening"]
        }
      }
    },
    "suggestions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starter", "dessert"],
      "properties": {
        "starter": { "$ref": "#/$defs/idList" },
        "dessert": { "$ref": "#/$defs/idList" }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["de", "en"],
      "properties": {
        "de": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^<>]*$" },
        "en": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^<>]*$" }
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "enum": ["vegetarian", "spicy"] },
        "text": { "$ref": "#/$defs/localizedText" }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tag" }
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "prices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dayCents"],
      "properties": {
        "dayCents": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "eveningCents": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "eveningPrefix": { "$ref": "#/$defs/localizedText" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "visibleNumber", "sort", "name", "prices", "available"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "visibleNumber": { "type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[A-Za-z0-9]+(?: [A-Za-z0-9]+)*$" },
        "sort": { "type": "integer", "minimum": 1 },
        "name": { "$ref": "#/$defs/localizedText" },
        "qualifier": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "tags": { "$ref": "#/$defs/tags" },
        "prices": { "$ref": "#/$defs/prices" },
        "available": { "type": "boolean" }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sort", "name", "items"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "sort": { "type": "integer", "minimum": 1 },
        "name": { "$ref": "#/$defs/localizedText" },
        "detail": { "$ref": "#/$defs/localizedText" },
        "note": { "$ref": "#/$defs/localizedText" },
        "notePosition": { "enum": ["before-items", "after-items"] },
        "tags": { "$ref": "#/$defs/tags" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    }
  }
}
