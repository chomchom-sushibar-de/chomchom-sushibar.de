{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chomchom-sushibar-de.github.io/schemas/site.schema.json",
  "title": "Chôm Chôm site settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["announcement", "hours"],
  "properties": {
    "announcement": {
      "$ref": "#/$defs/optionalLocalizedText"
    },
    "hours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekday", "sundayHolidays", "saturday"],
      "properties": {
        "weekday": {
          "allOf": [
            { "$ref": "#/$defs/openDayGroup" },
            {
              "type": "object",
              "properties": {
                "periods": { "type": "array", "minItems": 2, "maxItems": 2 }
              }
            }
          ]
        },
        "sundayHolidays": {
          "allOf": [
            { "$ref": "#/$defs/openDayGroup" },
            {
              "type": "object",
              "properties": {
                "periods": { "type": "array", "minItems": 1, "maxItems": 1 }
              }
            }
          ]
        },
        "saturday": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shortLabel", "tableLabel", "legalLabel", "status", "inlineStatus"],
          "properties": {
            "shortLabel": { "$ref": "#/$defs/localizedText" },
            "tableLabel": { "$ref": "#/$defs/localizedText" },
            "legalLabel": { "$ref": "#/$defs/localizedText" },
            "status": { "$ref": "#/$defs/localizedText" },
            "inlineStatus": { "$ref": "#/$defs/localizedText" }
          }
        }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["de", "en"],
      "properties": {
        "de": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^<>]*$" },
        "en": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^<>]*$" }
      }
    },
    "optionalLocalizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["de", "en"],
      "properties": {
        "de": { "type": "string", "maxLength": 240, "pattern": "^[^<>]*$" },
        "en": { "type": "string", "maxLength": 240, "pattern": "^[^<>]*$" }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opens", "closes"],
      "properties": {
        "opens": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
        "closes": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" }
      }
    },
    "openDayGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shortLabel", "tableLabel", "legalLabel", "schemaDays", "periods"],
      "properties": {
        "shortLabel": { "$ref": "#/$defs/localizedText" },
        "tableLabel": { "$ref": "#/$defs/localizedText" },
        "legalLabel": { "$ref": "#/$defs/localizedText" },
        "schemaDays": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
          }
        },
        "periods": {
          "type": "array",
          "items": { "$ref": "#/$defs/period" }
        }
      }
    }
  }
}
